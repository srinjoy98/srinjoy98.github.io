---
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${frontmatter.title} — Srinjoy Srimani`} description={frontmatter.summary}>
  <article style="padding: 64px 0 80px">
    <p class="tag grey" style="font-size:13px;margin-bottom:16px">NOTES · {frontmatter.topic?.toUpperCase()} · {frontmatter.date}</p>
    <h1 class="display" style="margin:0;font-weight:800;font-size:clamp(40px,6vw,60px);line-height:1.02;letter-spacing:-1.5px;max-width:800px">{frontmatter.title}</h1>
    {frontmatter.summary && <p class="muted" style="margin:24px 0 40px;font-size:21px;line-height:1.55;max-width:700px">{frontmatter.summary}</p>}
    <div class="prose"><slot /></div>
    <p class="mono" style="margin-top:48px;padding-top:24px;border-top:1.5px solid var(--ink);font-size:14px"><a href={`${base}/notes/`}>← All notes</a></p>
  </article>
</Base>
