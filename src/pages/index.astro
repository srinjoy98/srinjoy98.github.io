---
import Base from '../layouts/Base.astro';
import K5 from '../components/K5.astro';
import { existsSync } from 'node:fs';
// Drop a square photo at public/photo.jpg and it appears in the hero.
const hasPhoto = existsSync('public/photo.jpg');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notes = Object.values(import.meta.glob('./notes/*.md', { eager: true }))
  .sort((a, b) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)));
const latest = notes[0];
// Set to true to show the Off-axis section again (also re-add it to the nav in src/layouts/Base.astro).
const SHOW_OFFAXIS = false;
---
<Base>
  <section style="display:flex;flex-wrap:wrap;align-items:center;gap:48px;padding:72px 0 56px">
    <div style="flex:999 1 520px;min-width:0">
      <div style="display:flex;align-items:center;gap:18px;margin:0 0 24px">
        {hasPhoto && <img src={`${base}/photo.jpg`} alt="Srinjoy Srimani" width="96" height="96" style="width:96px;height:96px;border-radius:50%;object-fit:cover;flex:none" />}
        <p class="mono" style="margin:0;font-size:14px;color:var(--faint)">PhD candidate · Mathematics · UC San Diego</p>
      </div>
      <h1 class="display" style="margin:0;font-weight:800;font-size:clamp(56px,9vw,84px);line-height:.95;letter-spacing:-2.5px">Srinjoy Srimani<span style="color:var(--red)">.</span></h1>
      <p style="margin:28px 0 0;font-size:21px;line-height:1.55;max-width:560px">I work in extremal and probabilistic combinatorics at UC San Diego, advised by <a href="https://annatar0.wixsite.com/website-4">Jacques Verstraete</a>. Current projects: Eulerian orientations of regular graphs, explicit linear triple systems with small independence number, and Ramsey theory.</p>
      <p class="muted" style="margin:16px 0 0;font-size:17px;line-height:1.6;max-width:560px">Before UCSD: MASt (Part III) at the University of Cambridge; Sc.B. in Mathematics–Computer Science at Brown University (Hartshorne Freshman Prize); Budapest Semesters in Mathematics, Spring 2019.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
        <a class="btn solid" href={`${base}/cv.pdf`}>CV (PDF)</a>
        <a class="btn" href={`${base}/notes/`}>Read the notes →</a>
      </div>
    </div>
    <K5 />
  </section>

  <section id="research" class="section">
    <h2>Research</h2>
    <div class="body" style="display:flex;flex-direction:column;gap:28px">
      <article style="display:flex;flex-direction:column;gap:6px">
        <p class="tag red">IN PREPARATION</p>
        <h3 style="margin:0;font-size:20px;font-weight:500">Counting Eulerian Orientations in Regular Graphs</h3>
        <p class="muted" style="margin:0">with <a href="https://annatar0.wixsite.com/website-4">Jacques Verstraete</a> and Jason Yang · in preparation</p>
      </article>
      <article style="display:flex;flex-direction:column;gap:6px">
        <p class="tag blue">PUBLISHED · 2021</p>
        <h3 style="margin:0;font-size:20px;font-weight:500">Automorphism loci for degree 3 and degree 4 endomorphisms of the projective line</h3>
        <p class="muted" style="margin:0">with Brandon Gontmacher, Benjamin Hutz, Grayson Jorgenson and Simon Xu · <i>New York J. Math.</i> 27 (2021), 1613–1702 · from the ICERM REU, Summer 2019 · <a href="https://nyjm.albany.edu/j/2021/27-63.html">journal</a> · <a href="https://arxiv.org/abs/2007.15483">arXiv</a></p>
      </article>
      <article style="display:flex;flex-direction:column;gap:6px">
        <p class="tag grey">EXPOSITORY</p>
        <h3 style="margin:0;font-size:20px;font-weight:500">Bounds for Ramsey Numbers</h3>
        <p class="muted" style="margin:0">Part III essay, University of Cambridge · supervised by Tim Gowers · awarded a Distinction · <a href={`${base}/bounds-for-ramsey-numbers.pdf`}>pdf</a></p>
      </article>
      <article style="display:flex;flex-direction:column;gap:6px">
        <p class="tag grey">TALKS</p>
        <p class="muted" style="margin:0">REU research presented at the Joint Mathematics Meetings (JMM), January 2020, and at SUMS 2020.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <h2>Elsewhere on the site</h2>
    <div class="body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px">
      <a class="card-link" href={latest ? latest.url : `${base}/notes/`}>
        <span class="tag red">NOTES</span>
        <span class="card-title">{latest ? latest.frontmatter.title : 'Notes'}</span>
        <span class="muted" style="font-size:15px">Expository write-ups and study notes.</span>
      </a>
      <a class="card-link" href={`${base}/playground/`}>
        <span class="tag blue">PLAYGROUND</span>
        <span class="card-title">[Your first interactive tool]</span>
        <span class="muted" style="font-size:15px">In-browser maths tools, added one at a time.</span>
      </a>
    </div>
  </section>

  <section id="teaching" class="section">
    <h2>Teaching</h2>
    <div class="body">
      {[['Enumerative Combinatorics','Lead TA · UCSD'],['Graph Theory','Lead TA · UCSD'],['Number Theory','Lead TA · UCSD'],['Linear Algebra','Lead TA · UCSD'],['Calculus I–II','Lead TA · UCSD'],['Measure Theory, Complex Analysis, Abstract Algebra, Cryptography, Geometry','TA · Brown · 2018–2020']].map(([c, t]) => (
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;padding:14px 0;border-bottom:1px dashed var(--rule-2)">
          <span>{c}</span><span class="mono muted" style="font-size:14px">{t}</span>
        </div>
      ))}
    </div>
  </section>

  {SHOW_OFFAXIS && (
  <section id="offaxis" class="section">
    <h2>Off-axis</h2>
    <div class="body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px">
      <div class="tile"><p style="font-weight:500">Jazz piano</p><p>Daily practice. Currently: Blue in Green, Elsa, Take Five, 500 Miles High.</p></div>
      <div class="tile"><p style="font-weight:500">Blues / rock guitar</p><p>Mostly John Mayer, on a cream Strat and a Baby Taylor.</p></div>
      <div class="tile"><p style="font-weight:500">Bookshelf</p><p>[Reading now, favourites]</p></div>
      <div class="tile"><p style="font-weight:500">History, currently</p><p>[The era you're reading about, and why]</p></div>
    </div>
  </section>
  )}
</Base>
